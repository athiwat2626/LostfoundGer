# Caddy ของ FOUND&LOST (อยู่ใน container web) — รับ HTTP ที่ :80 ภายใน container เท่านั้น
# บน VPS: compose map เป็น 127.0.0.1:${APP_PORT} แล้ว Nginx ของเครื่อง (deploy/nginx.conf) ทำ HTTPS ให้
# จึงไม่แย่งพอร์ต 80/443 กับเว็บอื่นที่อยู่บน VPS เดียวกัน
{
	auto_https off
	servers {
		# เชื่อ X-Forwarded-* จาก Nginx ของเครื่อง (ผ่าน docker network ที่เป็น private IP)
		trusted_proxies static private_ranges
	}
}

:80 {
	encode zstd gzip

	# รูปอัปโหลดจำกัด 5 MB ต่อไฟล์ (multer) เผื่อข้อมูลฟอร์มอีกเล็กน้อย
	request_body {
		max_size 6MB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# API ทั้งหมด (รวม LINE webhook) — ตัด /backend ออกก่อนส่งให้ Express จึงไม่ต้องแก้ route
	handle_path /backend/* {
		reverse_proxy backend:3000
	}

	# หน้าเว็บ React: ไฟล์ใน /assets มี hash ในชื่อ cache ได้นาน ส่วน path อื่นส่ง index.html (SPA)
	handle {
		root * /srv
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@html not path /assets/*
		header @html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
