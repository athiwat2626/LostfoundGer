# คัดลอกเป็นไฟล์ backend.env ข้าง compose.deploy.yml บน VPS แล้ว chmod 600 backend.env
# ค่า DB_* ไม่ต้องใส่ — compose.deploy.yml ส่งให้จาก .env เอง
# ห้าม commit ค่าจริง ห้ามพิมพ์ลง log

# สุ่มใหม่สำหรับ production: openssl rand -hex 48
JWT_SECRET=change-me
JWT_TTL=8h
USER_JWT_TTL=7d

# บัญชีแอดมินแรก (สร้างครั้งเดียวตอนยังไม่มี แล้วเปลี่ยนรหัสในหน้าตั้งค่า)
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=change-me

# Gmail + App Password สำหรับส่ง OTP / แจ้งเตือน / เกียรติบัตร
MAIL_USER=your-account@gmail.com
MAIL_APP_PASSWORD=change-me

# URL ของหน้าเว็บ (ตรงกับ APP_DOMAIN) ใช้สร้างลิงก์ในอีเมล, ข้อความ LINE และ Rich Menu
APP_BASE_URL=https://app.foundlost.tech

# LINE Messaging API — Webhook URL: https://<APP_DOMAIN>/backend/api/line/webhook
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_BOT_BASIC_ID=
LINE_LINK_TOKEN_TTL_MINUTES=15
LINE_USER_ID=
NOTIFY_API_KEY=

# Google Sign-In — เพิ่ม https://<APP_DOMAIN> ใน Authorized JavaScript origins
GOOGLE_CLIENT_ID=
GOOGLE_ALLOWED_DOMAINS=
