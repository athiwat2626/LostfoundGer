# คัดลอกเป็นไฟล์ .env ข้าง compose.deploy.yml บน VPS แล้ว chmod 600 .env
# ห้าม commit ค่าจริง

# โดเมนของเว็บ (ไม่มี https:// ไม่มี / ท้าย) — ทดสอบในเครื่องใช้ http://localhost
APP_DOMAIN=app.foundlost.tech
# อีเมลรับแจ้งเตือนใบรับรองจาก Let's Encrypt
ACME_EMAIL=you@example.com

# image ที่ GitHub Actions push ขึ้น GHCR — deploy.sh จะแก้ 2 บรรทัดนี้ให้ตาม tag ที่ deploy
BACKEND_IMAGE=ghcr.io/athiwat2626/foundlost-backend:latest
WEB_IMAGE=ghcr.io/athiwat2626/foundlost-web:latest

# PostgreSQL (สร้างครั้งแรกตอน volume ยังว่าง เปลี่ยนรหัสภายหลังต้องเปลี่ยนใน DB ด้วย)
# สุ่มรหัส: openssl rand -hex 24
POSTGRES_DB=foundlost_db
POSTGRES_USER=foundlost
POSTGRES_PASSWORD=change-me

# พอร์ตบน host (ปกติไม่ต้องแก้)
# HTTP_PORT=80
# HTTPS_PORT=443
