# ตัวอย่างค่า environment ของระบบ FOUND&LOST
# คัดลอกไฟล์นี้ไปเป็น backend/.env (ไม่ใช่ .env ที่ root) แล้วเปลี่ยนค่าทุกช่องที่เป็น change-me
# ไฟล์ backend/.env จริงถูก ignore จาก Git ห้ามใส่รหัสผ่านจริงในไฟล์ตัวอย่างนี้

# ── PostgreSQL (docker compose เปิดที่พอร์ต 5433 ของเครื่อง) ─────────────────
POSTGRES_DB=foundlost_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

DB_HOST=localhost
DB_PORT=5433
DB_NAME=foundlost_db
DB_USER=postgres
DB_PASSWORD=change-me
# DB_POOL_MAX=10

# ── pgAdmin (http://localhost:5050) ──────────────────────────────────────────
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me

# ── Backend ──────────────────────────────────────────────────────────────────
PORT=3000
# สุ่มค่ายาว ๆ เช่น: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL=8h
USER_JWT_TTL=7d

# บัญชีแอดมินเริ่มต้น (สร้างครั้งแรกที่เริ่ม backend เท่านั้น เปลี่ยนรหัสผ่านได้ในหน้าตั้งค่า)
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=change-me

# ── อีเมล (Gmail App Password) สำหรับส่ง OTP และเกียรติบัตร ────────────────────
MAIL_USER=your-account@gmail.com
MAIL_APP_PASSWORD=change-me

# ── เว็บแอป ────────────────────────────────────────────────────────────────
# URL จริงของหน้าเว็บ (frontend) ไม่มี / ท้าย ใช้สร้างลิงก์ในข้อความ LINE, Rich Menu และอีเมล
# ต้องเป็น https และเปิดได้จากมือถือเมื่อใช้งานกับ LINE จริง เช่น https://lostfound.example.ac.th
APP_BASE_URL=

# ── LINE Messaging API (ดูขั้นตอนใน README-LINE.md) ───────────────────────────
# LINE Developers → Channel ของ Messaging API → แท็บ Basic settings / Messaging API
# ห้าม commit ค่าจริง ห้ามใส่ใน frontend และห้ามพิมพ์ลง log
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# Basic ID ของ Official Account เช่น @123abcde (ไม่ใช่ความลับ) ใช้แสดงปุ่ม "เพิ่มเพื่อน" ในหน้าเว็บ
LINE_BOT_BASIC_ID=
# อายุลิงก์เชื่อมบัญชี (นาที, 1–60)
LINE_LINK_TOKEN_TTL_MINUTES=15

# ฟีดแจ้งผู้ดูแลเมื่อมีโพสต์ใหม่ (ไม่บังคับ): LINE user ID ของผู้ดูแล
LINE_USER_ID=
# ถ้าตั้งค่า จะต้องส่ง header x-api-key มาด้วยเมื่อเรียก POST /api/notifications/line
NOTIFY_API_KEY=

# ทดสอบ SQL ของระบบ LINE กับ PostgreSQL (ไม่บังคับ — ใช้ฐานข้อมูลทดสอบเท่านั้น)
# TEST_DATABASE_URL=postgres://postgres:testpass@localhost:55432/postgres
