# Docker Compose database and pgAdmin credentials.
# Copy this file to backend/.env (not the project-root .env), then replace all
# example passwords before running Docker. The real backend/.env is ignored by Git.
POSTGRES_DB=foundlost_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-database-password
PGADMIN_DEFAULT_EMAIL=admin@foundlost.local
PGADMIN_DEFAULT_PASSWORD=replace-with-a-strong-pgadmin-password
