# PostgreSQL
DB_HOST=localhost
# Use 5433 when PostgreSQL is started through this project's Docker Compose file.
DB_PORT=5433
DB_NAME=foundlost_db
DB_USER=postgres
DB_PASSWORD=replace-with-a-strong-password
DB_POOL_MAX=10

# Docker Compose reuses DB_PASSWORD for the existing PostgreSQL data volume.
POSTGRES_PASSWORD=${DB_PASSWORD}
PGADMIN_DEFAULT_EMAIL=admin@foundlost.local
PGADMIN_DEFAULT_PASSWORD=replace-with-a-strong-pgadmin-password

# Gmail account and a newly created Gmail app password for OTP delivery
MAIL_USER=your-email@gmail.com
MAIL_APP_PASSWORD=replace-with-a-new-gmail-app-password
